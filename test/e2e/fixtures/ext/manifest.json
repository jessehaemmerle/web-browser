{
  "manifest_version": 3,
  "name": "Nimbus Test Extension",
  "version": "1.0.0",
  "description": "Marks pages so the E2E test can see that content scripts run.",
  "action": { "default_title": "Nimbus Test", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_end" }],
  "background": { "service_worker": "bg.js" },
  "permissions": ["storage"]
}
